<robot name="pulgar">
	<link name="thumb_link0_passive">
		<visual>
			<material name="blue">
				<color rgba="0 0 .8 1"/>
			</material>
			<geometry>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<cylinder length="0.0" radius="0.0"/>
			</geometry>
		</visual>
	</link>
	<link name="thumb_link0_x_axis">
		<visual>
			<material name="red">
				<color rgba="1 0 0 1"/>
			</material>
			<geometry>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<cylinder length="0.0" radius="0.0"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q0_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="thumb_link0_passive"/>
		<child link="thumb_link0_x_axis"/>
	</joint>

	<link name="thumb_link1"/>
	<link name="thumb_link1_x_axis">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="red"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q20" type="revolute">
		<origin xyz="0 0 0.5" rpy="0 0 0"/>
		<parent link="thumb_link0_passive"/>
		<child link="thumb_link1"/>
		<axis xyz="0 0 1"/>
        <limit effort="300" velocity="0.1" lower="-3.1416" upper="3.1416"/>
	</joint>
	<joint name="thumb_q1_passive" type="fixed">
		<origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
		<parent link="thumb_link1"/>
		<child link="thumb_link1_passive"/>
	</joint>
	<link name="thumb_link1_passive">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="blue"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q1_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="thumb_link1_passive"/>
		<child link="thumb_link1_x_axis"/>
	</joint>

	<link name="thumb_link2"/>
	<link name="thumb_link2_x_axis">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="red"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q21" type="revolute">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="thumb_link1_passive"/>
		<child link="thumb_link2"/>
		<axis xyz="0 0 1"/>
        <limit effort="300" velocity="0.1" lower="-3.1416" upper="3.1416"/>
	</joint>
	<joint name="thumb_q2_passive" type="fixed">
		<origin xyz="1.3 0 0" rpy="0 0 0"/>
		<parent link="thumb_link2"/>
		<child link="thumb_link2_passive"/>
	</joint>
	<link name="thumb_link2_passive">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="blue"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q2_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="thumb_link2_passive"/>
		<child link="thumb_link2_x_axis"/>
	</joint>

	<link name="thumb_link3"/>
	<link name="thumb_link3_x_axis">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="red"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q22" type="revolute">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="thumb_link2_passive"/>
		<child link="thumb_link3"/>
		<axis xyz="0 0 1"/>
        <limit effort="300" velocity="0.1" lower="-3.1416" upper="3.1416"/>
	</joint>
	<joint name="thumb_q3_passive" type="fixed">
		<origin xyz="0.9 0 0" rpy="0 0 0"/>
		<parent link="thumb_link3"/>
		<child link="thumb_link3_passive"/>
	</joint>
	<link name="thumb_link3_passive">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="blue"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="thumb_q3_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="thumb_link3_passive"/>
		<child link="thumb_link3_x_axis"/>
	</joint>
</robot>
